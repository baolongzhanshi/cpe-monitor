{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CPE Monitor",
  "version": "0.3.6",
  "identifier": "com.cpeye.monitor",
  "build": {
    "frontendDist": "../desktop-shell"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self' http://127.0.0.1:3210; connect-src 'self' http://127.0.0.1:3210; img-src 'self' data: blob: http://127.0.0.1:3210; style-src 'self' 'unsafe-inline' http://127.0.0.1:3210; script-src 'self' 'unsafe-inline' 'unsafe-eval' http://127.0.0.1:3210"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "resources": [
      "resources/server"
    ],
    "externalBin": [
      "binaries/node"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "languages": [
          "SimpChinese"
        ]
      },
      "webviewInstallMode": {
        "type": "skip"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ]
  }
}
